{
  "version": 2,
  "builds": [
    {
      "src": "news_summary_bot.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/run-bot",
      "dest": "news_summary_bot.py",
      "methods": ["GET", "POST"],
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Methods": "GET,POST",
        "Access-Control-Allow-Headers": "Content-Type"
      }
    }
  ]
}
